# Public Supabase project configuration. Copy to .env.local, then rebuild/restart Vite.
# Institutional workspaces are account-first: without Supabase, registration/codes are intentionally unavailable.
# Never place a service_role, sb_secret_, database password or SMTP secret here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
